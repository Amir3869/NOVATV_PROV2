# ============================================================
#  NOVA TV — modèle de variables d'environnement
# ============================================================
# COMMENT UTILISER CE FICHIER
#
#   1. Copier ce fichier :        cp .env.example .env.local
#   2. Remplir les valeurs dans   .env.local
#   3. Ne JAMAIS committer        .env.local  (il est dans .gitignore)
#
# Ce fichier-ci ne contient que des exemples et des explications.
# Il est versionné pour que chacun sache quelles variables existent.
# Il ne doit contenir AUCUNE valeur réelle.
# ============================================================

# ------------------------------------------------------------
# Rappel d'architecture
# ------------------------------------------------------------
# Nova TV est une application 100 % locale.
# Il n'y a ni serveur, ni base de données distante, ni compte en ligne.
# Les identifiants IPTV de l'utilisateur sont saisis DANS l'application,
# chiffrés, puis stockés dans IndexedDB sur son appareil.
#
# Ils ne passent donc JAMAIS par ce fichier.
# ------------------------------------------------------------


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Nom affiché dans l'interface.
NEXT_PUBLIC_APP_NAME="Nova TV"

# Version affichée dans Réglages > À propos.
NEXT_PUBLIC_APP_VERSION="0.1.0"


# ------------------------------------------------------------
# Cible de compilation
# ------------------------------------------------------------
# "web"      : développement local et site vitrine
# "capacitor": export statique destiné à l'APK Android
#
# Cette variable pilotera l'activation de `output: 'export'`
# dans next.config.ts à partir de la Phase 9.
NEXT_PUBLIC_BUILD_TARGET="web"


# ------------------------------------------------------------
# Développement
# ------------------------------------------------------------

# Active les journaux détaillés dans la console.
NEXT_PUBLIC_DEBUG="false"


# ------------------------------------------------------------
# Live reload Capacitor (Phase 9 — développement uniquement)
# ------------------------------------------------------------
# Adresse IP du PC de développement sur le réseau local.
# Permet au Firestick d'afficher l'interface servie par le PC,
# et donc de voir les modifications en 1 à 2 secondes
# sans réinstaller l'APK.
#
# Trouver son IP :   Windows -> ipconfig     macOS/Linux -> ifconfig
# Exemple de valeur : 192.168.1.42
# CAPACITOR_DEV_SERVER_IP=""


# ------------------------------------------------------------
# Réservé — fonctionnalités futures
# ------------------------------------------------------------
# Ces variables ne sont PAS utilisées en v1.
# Elles sont listées pour mémoire.

# Jaquettes de films/séries (offre gratuite).
# ATTENTION : l'attribution visuelle "This product uses the TMDB API
# but is not endorsed or certified by TMDB" est obligatoire.
# TMDB_API_KEY=""

# Synchronisation multi-appareils (offre premium, hors v1).
# DATABASE_URL=""
